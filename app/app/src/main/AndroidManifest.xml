<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Downloads: a long-running (dataSync) foreground worker with a progress notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Player: a foreground media service (notification, lock-screen controls) that keeps the CPU and Wi-Fi awake while a book plays. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- BitTorrent engine (core/torrent): foreground service of type dataSync, its notification, and a wake lock held only while data flows; the player shares the wake lock. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Package visibility (Android 11+): the playback service checks a controller's package name against its uid (core/player/TrustedControllers). -->
    <queries>
        <package android:name="com.google.android.projection.gearhead" />
        <package android:name="com.google.android.projection.gearhead.emulator" />
        <package android:name="com.google.android.gms" />
        <package android:name="com.google.android.googlequicksearchbox" />
        <package android:name="com.google.android.apps.googleassistant" />
        <package android:name="com.google.android.apps.bard" />
        <package android:name="com.google.android.carassistant" />
        <package android:name="com.android.systemui" />
        <package android:name="com.android.bluetooth" />
        <package android:name="com.google.android.bluetooth" />
        <package android:name="com.google.android.wearable.app" />
        <package android:name="com.google.android.apps.wear.companion" />
    </queries>

    <application
        android:name=".AudiobooksApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Audiobooks">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- WorkManager's foreground service for the download workers must declare its type. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- The playback service holds the ExoPlayer and the media session. Exported so controllers (lock screen, Bluetooth, later Android Auto) can bind; onConnect admits only trusted controllers (TrustedControllers). -->
        <service
            android:name=".core.player.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- PackageInstaller session status; reached only through the PendingIntent the app created. -->
        <receiver android:name=".core.update.InstallResultReceiver" android:exported="false" />

        <service
            android:name=".core.torrent.TorrentService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>
